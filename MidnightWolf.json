@import url("https://refact0r.github.io/system24/build/system24.css");

:root {
    --bg: #000000;
    --bg-secondary: #080808;
    --bg-tertiary: #101010;

    --text: #ffffff;
    --text-muted: #9d9d9d;

    --accent: #ffffff;
    --accent-hover: #d8d8d8;

    --border: #222222;

    /* Replace this with your image URL */
    --background-image: url("YOUR_IMAGE_URL");

    --background-blur: 0px;
    --background-brightness: 0.3;
}

/* Background */
.appMount-2yBXZl,
.bg-1QIAus {
    background: var(--bg) !important;
    background-image: var(--background-image) !important;
    background-position: center;
    background-repeat: no-repeat;
    background-size: 260px;
}

/* Chat */
.chat-2ZfjoI,
.container-2cd8Mz {
    background: rgba(0,0,0,.82) !important;
}

/* Sidebar */
.sidebar-1tnWFu {
    background: #050505 !important;
}

/* Member list */
.membersWrap-3NUR2t,
.members-3WRCEx {
    background: #050505 !important;
}

/* Messages */
.message-2CShn3:hover {
    background: rgba(255,255,255,.03);
}

/* Buttons */
.button-f2h6uQ {
    border-radius: 10px;
    transition: .2s;
}

.button-f2h6uQ:hover {
    box-shadow: 0 0 12px rgba(255,255,255,.25);
}

/* Scrollbars */
::-webkit-scrollbar-thumb {
    background: #333;
}

::-webkit-scrollbar-track {
    background: transparent;
}
